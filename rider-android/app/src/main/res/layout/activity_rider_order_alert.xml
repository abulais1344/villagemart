<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#7C3AED">

    <!-- Full-screen tap target — rider taps anywhere here to open the order -->
    <LinearLayout
        android:id="@+id/layoutTapArea"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="32dp"
        android:clickable="true"
        android:focusable="true">

        <!-- Moped icon -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛵"
            android:textSize="72sp"
            android:paddingBottom="16dp" />

        <!-- "NEW ORDER!" headline -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NEW ORDER!"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:paddingBottom="24dp" />

        <!-- White detail card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PICKUP FROM"
                android:textColor="#7C3AED"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <TextView
                android:id="@+id/tvStoreName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="#111827"
                android:textSize="22sp"
                android:textStyle="bold"
                android:paddingTop="2dp"
                android:paddingBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ORDER"
                android:textColor="#7C3AED"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <TextView
                android:id="@+id/tvItemCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="#374151"
                android:textSize="17sp"
                android:paddingTop="2dp"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/tvOrderId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#9CA3AF"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Tap hint -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tap anywhere to view order"
            android:textColor="#DDD6FE"
            android:textSize="14sp"
            android:gravity="center"
            android:paddingTop="24dp" />
    </LinearLayout>

    <!-- Dismiss-only ✕ button — top-right, above the tap area -->
    <TextView
        android:id="@+id/btnDismiss"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:text="✕"
        android:textColor="#EDE9FE"
        android:textSize="20sp"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="@android:color/transparent" />

</FrameLayout>
